{
  "name": "@onderwijsin/onderwijsloket-assistent",
  "private": true,
  "description": "An experimental MCP server for Assistent UI for Onderwijsloket",
  "type": "module",
  "scripts": {
    "build": "nuxt cleanup && NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt build --profile=verbose",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "env:check": "varlock load",
    "env:typegen": "varlock codegen",
    "prepare": "nuxt prepare",
    "skills:update": "pnpm dlx skills@latest update -p",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/vue": "catalog:",
    "@comark/nuxt": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/image": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/mcp-toolkit": "catalog:",
    "@nuxtjs/plausible": "catalog:",
    "@nuxtjs/seo": "catalog:",
    "@onderwijsin/nuxt-directus-client": "catalog:",
    "@onderwijsin/nuxt-directus-config": "catalog:",
    "@onderwijsin/nuxt-healthcheck": "catalog:",
    "@onderwijsin/nuxt-newsletter-signup": "catalog:",
    "@pinia/nuxt": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@varlock/nuxt-integration": "catalog:",
    "@varlock/proton-pass-plugin": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "ai": "catalog:",
    "algoliasearch": "catalog:",
    "defu": "catalog:",
    "h3": "catalog:",
    "motion-v": "catalog:",
    "nuxt": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "tailwindcss": "catalog:",
    "ufo": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@directus/types": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@12.11.2",
  "varlock": {
    "loadPath": "./envs/"
  }
}
